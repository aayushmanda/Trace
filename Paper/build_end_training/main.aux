\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Outcome escape slows with the horizon, and its training accuracy tracks the remaining answer bias.} (a)~Zero-readout counting, $K=2$, $\lambda =0.5$, $\sigma =0.002$: accumulated training time to leave the initialization ball. Lines show medians over three draws; dots show each draw. The dashed guide scales as $\lambda ^{-n}$ and is anchored at $n=4$; it is not a fitted time bound. (b)~All $60$ runs in the $20$ horizon--contraction cells: $n\in \{6,8,10,12,16\}$, four alphabets, three seeds, $8$k updates. Outcome accuracy approaches chance as $\lambda ^n$ falls; step results remain seed-dependent. The dashed curve is the state-only prior accuracy $(1+\lambda ^n)/2$; the dotted line is chance.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:theory-measurement}{{2}{7}{\textbf {Outcome escape slows with the horizon, and its training accuracy tracks the remaining answer bias.} (a)~Zero-readout counting, $K=2$, $\mixrate =0.5$, $\initscale =0.002$: accumulated training time to leave the initialization ball. Lines show medians over three draws; dots show each draw. The dashed guide scales as $\mixrate ^{-n}$ and is anchored at $n=4$; it is not a fitted time bound. (b)~All $60$ runs in the $20$ horizon--contraction cells: $n\in \{6,8,10,12,16\}$, four alphabets, three seeds, $8$k updates. Outcome accuracy approaches chance as $\mixrate ^n$ falls; step results remain seed-dependent. The dashed curve is the state-only prior accuracy $(1+\mixrate ^n)/2$; the dotted line is chance}{figure.caption.13}{}}
\newlabel{fig:theory-measurement@cref}{{[figure][2][]2}{[1][6][]7}{}{}{}}
