\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Outcome escape is slow; outcome training learns the low-degree prior and little else.} (a)~Zero-readout counting, $K=2$, $\lambda =0.5$, $\sigma =0.002$: median exit time and interquartile band over three draws; the dashed $\lambda ^{-n}$ guide is anchored at $n=4$. The step exit reflects fitting the count-only prior, not learning the rule. (b)~Outcome exact accuracy after $8$k AdamW updates in $20$ horizon--alphabet cells: means and seed ranges over three seeds; the green curve is the state-only prior $(1+\lambda ^n)/2$, and gray is chance. (c)~The same accuracies minus the prior. Correlations use cell means.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:theory-measurement}{{2}{6}{\textbf {Outcome escape is slow; outcome training learns the low-degree prior and little else.} (a)~Zero-readout counting, $K=2$, $\mixrate =0.5$, $\initscale =0.002$: median exit time and interquartile band over three draws; the dashed $\mixrate ^{-n}$ guide is anchored at $n=4$. The step exit reflects fitting the count-only prior, not learning the rule. (b)~Outcome exact accuracy after $8$k AdamW updates in $20$ horizon--alphabet cells: means and seed ranges over three seeds; the green curve is the state-only prior $(1+\mixrate ^n)/2$, and gray is chance. (c)~The same accuracies minus the prior. Correlations use cell means}{figure.caption.10}{}}
\newlabel{fig:theory-measurement@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
\newlabel{fig:lambda-grid}{{2}{6}{\textbf {Outcome escape is slow; outcome training learns the low-degree prior and little else.} (a)~Zero-readout counting, $K=2$, $\mixrate =0.5$, $\initscale =0.002$: median exit time and interquartile band over three draws; the dashed $\mixrate ^{-n}$ guide is anchored at $n=4$. The step exit reflects fitting the count-only prior, not learning the rule. (b)~Outcome exact accuracy after $8$k AdamW updates in $20$ horizon--alphabet cells: means and seed ranges over three seeds; the green curve is the state-only prior $(1+\mixrate ^n)/2$, and gray is chance. (c)~The same accuracies minus the prior. Correlations use cell means}{figure.caption.10}{}}
\newlabel{fig:lambda-grid@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
