\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Answers alone mostly fail where the answer has little low-degree part; steps mostly succeed.} Accuracy (\%) on held-out prompts, ranges over seeds; the BIG-Bench Hard rows test on the $750$ real items. First occurrence keeps a degree-$1$ part at every $n$, and outcome learns it. Counting modulo~$2$: zero readout, $8{,}000$ updates for both formats, mean over ten paired seeds (solved seeds in parentheses). Counting modulo~$3$: $32$k updates, seeds $42$--$44$. For every task, $\lambda $ is the contraction coefficient of \cref  {def:lambda} for the averaged move: the largest singular value of $\bar  T$ on mean-zero vectors. For counting and BIG-Bench Hard it sets the low-degree share; for Boolean-8 and the register machine it is only the slowest of many state modes, so the single-mode value $\lambda ^{2n}+n\lambda ^{2(n-1)}(1-\lambda ^2)$ ($20\%$ and $56\%$) far overstates their measured degree-$\le 1$ shares ($1.1\%$ and $0.08\%$). Protocols are in \cref  {app:experiments}.}}{30}{table.caption.46}\protected@file@percent }
\newlabel{tab:main}{{7}{30}{\textbf {Answers alone mostly fail where the answer has little low-degree part; steps mostly succeed.} Accuracy (\%) on held-out prompts, ranges over seeds; the BIG-Bench Hard rows test on the $750$ real items. First occurrence keeps a degree-$1$ part at every $n$, and outcome learns it. Counting modulo~$2$: zero readout, $8{,}000$ updates for both formats, mean over ten paired seeds (solved seeds in parentheses). Counting modulo~$3$: $32$k updates, seeds $42$--$44$. For every task, $\mixrate $ is the contraction coefficient of \cref {def:lambda} for the averaged move: the largest singular value of $\bar T$ on mean-zero vectors. For counting and BIG-Bench Hard it sets the low-degree share; for Boolean-8 and the register machine it is only the slowest of many state modes, so the single-mode value $\mixrate ^{2n}+n\mixrate ^{2(n-1)}(1-\mixrate ^2)$ ($20\%$ and $56\%$) far overstates their measured degree-$\le 1$ shares ($1.1\%$ and $0.08\%$). Protocols are in \cref {app:experiments}}{table.caption.46}{}}
\newlabel{tab:main@cref}{{[table][7][]7}{[1][29][]30}{}{}{}}
